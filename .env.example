# Current launch configuration
#
# No environment variables are required for the current public site.
# Contact opens a prefilled email to contact.cargofish@gmail.com.
# The main demo and NYC Fleet Show videos are embedded directly from LinkedIn in src/content/siteContent.ts.

# Optional production URL override used for canonical and social metadata.
# If the domain changes, also update public/robots.txt and public/sitemap.xml.
VITE_SITE_URL=https://www.cargofish.com

# Optional future Resend setup for server-side contact-form delivery.
# Get RESEND_API_KEY from Resend Dashboard > API Keys.
# Create CONTACT_FROM_EMAIL by verifying a sender domain/subdomain in Resend.
# Leave these commented out unless the contact form is switched back to /api/contact delivery.
# RESEND_API_KEY=re_example_replace_with_real_resend_api_key
# CONTACT_TO_EMAIL=contact.cargofish@gmail.com
# CONTACT_FROM_EMAIL=website@send.cargofish.com
