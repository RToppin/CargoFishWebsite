# Required for contact-form email delivery through Resend.
# Get this from Resend Dashboard > API Keys.
RESEND_API_KEY=re_example_replace_with_real_resend_api_key

# Optional: inbox that receives contact-form notifications.
# If omitted, the API defaults to contact.cargofish@gmail.com.
CONTACT_TO_EMAIL=contact.cargofish@gmail.com

# Optional: sender address for Resend.
# If omitted, the API defaults to Resend's sample sender:
# CargoFish Website <onboarding@resend.dev>
#
# For better production deliverability later, verify a domain/subdomain in Resend
# and set this to something like website@send.cargofish.com.
# CONTACT_FROM_EMAIL=website@send.cargofish.com

# Optional: production URL override used for canonical and social metadata.
# If omitted, the site defaults to https://www.cargofish.com.
VITE_SITE_URL=https://www.cargofish.com
